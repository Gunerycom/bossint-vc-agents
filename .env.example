# Server Configuration
PORT=3000

# Bossint Intelligence API Key (kept secure on server)
BOSSINT_API_KEY=

# Base Host for Bossint API
BOSSINT_API_HOST=https://lab.bossint.ai

# Agent 04 UUID (Configurable constant for Top 10 VC Leaders Surveillance)
AGENT_04_ID=48e1324f-e880-4592-b630-f1c01f076ade

# Resend API Key (Sign up at https://resend.com)
RESEND_API_KEY=re_your_api_key_here
